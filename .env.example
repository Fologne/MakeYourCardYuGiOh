# Configuracoes de Inteligencia Artificial
GEMINI_API_KEY=chaveGemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
HUGGINGFACE_API_KEY=chaveHuggingFace
# Opcional. Deixe vazio para usar apenas Pollinations na geracao de imagens.
HF_IMAGE_MODEL=

# Configuracoes de Banco de Dados
DB_URI=

# Configuracoes de Servidor e Seguranca
PORT=3000
# Obrigatorio, com no minimo 16 caracteres. Gere um valor aleatorio forte.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Origens extras permitidas no CORS, separadas por virgula.
# Localhost e 127.0.0.1 em qualquer porta sao liberados automaticamente.
CORS_ORIGINS=
